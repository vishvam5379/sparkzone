# PostgreSQL Database URL for Railway / Production
# Format: postgresql://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgresql://postgres:password@localhost:5432/sparkzonedb

# Persistent connection lifetime in seconds (default: 600)
CONN_MAX_AGE=600

# Django Security Settings
SECRET_KEY=django-insecure-change-this-in-production-secret-key
DEBUG=False
ALLOWED_HOSTS=sparkzone-production.up.railway.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.up.railway.app,https://*.onrender.com,http://localhost,http://127.0.0.1

# Session Settings
SESSION_COOKIE_AGE=1209600

# Cloudinary Cloud Media Storage (Required for Vercel / Production file uploads)
# Sign up free at https://cloudinary.com and add these keys in Vercel Project Environment Variables
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Alternatively, set CLOUDINARY_URL:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Python Runtime Version
PYTHON_VERSION=3.12.3
